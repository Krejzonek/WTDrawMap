{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": false,
      ".write": false,
      "$room": {
        ".read": "$room.matches(/^WT-[A-Z0-9]{6}$/) && !data.exists()",
        ".write": "$room.matches(/^WT-[A-Z0-9]{6}$/) && ((!data.exists() && newData.child('host').isString() && newData.child('host').val().length > 0 && newData.child('active').val() === true) || (!newData.exists()))",

        "host": {
          ".read": true,
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },

        "hostName": {
          ".read": true,
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },

        "createdAt": {
          ".read": true,
          ".validate": "newData.isNumber()"
        },

        "active": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isBoolean()"
        },

        "members": {
          ".read": true,
          ".write": true,

          "$uid": {
            ".read": true,
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'host', 'canDraw']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('host').isBoolean() && newData.child('canDraw').isBoolean())"
          }
        },

        "signals": {
          ".read": true,
          ".write": true,

          "$uid": {
            ".read": true,
            ".write": true
          }
        },

        "bans": {
          "$uid": {
            ".read": true,
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChild('timestamp') && newData.child('timestamp').isNumber())"
          }
        },

        "moderation": {
          "$uid": {
            ".read": true,
            ".write": true,
            ".validate": "!newData.exists() || (newData.hasChildren(['action', 'timestamp']) && newData.child('action').isString() && newData.child('timestamp').isNumber())"
          }
        }
      }
    }
  }
}