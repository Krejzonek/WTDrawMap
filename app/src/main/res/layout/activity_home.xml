<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/HomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1018">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B1018">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:background="#111A27"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAR THUNDER"
                    android:textColor="#EAF2FC"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="MAP COMPANION"
                    android:textColor="#7F98B5"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

            </LinearLayout>

            <TextView
                android:id="@+id/UsernameButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/home_button_secondary"
                android:drawableStart="@drawable/ic_menu"
                android:drawablePadding="8dp"
                android:text="Gracz"
                android:textColor="#DCE8F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxWidth="150dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="42dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION CENTER"
                    android:textColor="#72B7F5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Play together"
                    android:textColor="#EAF2FC"
                    android:textSize="29sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Create a session or join your friends to share the same tactical map."
                    android:textColor="#91A5BC"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/home_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01 / HOST"
                        android:textColor="#72B7F5"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Create a session"
                        android:textColor="#EAF2FC"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Become the host and share your War Thunder map with other players."
                        android:textColor="#91A5BC"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <Button
                        android:id="@+id/CreateSessionButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:backgroundTint="#2879D4"
                        android:text="CREATE SESSION"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/home_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02 / PARTICIPANT"
                        android:textColor="#72B7F5"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Join a session"
                        android:textColor="#EAF2FC"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Join an existing session using a code provided by the host."
                        android:textColor="#91A5BC"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <Button
                        android:id="@+id/JoinSessionButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:backgroundTint="#263B55"
                        android:text="JOIN SESSION"
                        android:textColor="#DCE8F5"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="WAR THUNDER MAP COMPANION"
                    android:textColor="#53677F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>