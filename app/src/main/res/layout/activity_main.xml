<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1018"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B1018">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:background="#111A27"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/TacticalMap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="Open menu"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#DCE8F5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WAR THUNDER"
                    android:textColor="#EAF2FC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TACTICAL MAP"
                    android:textColor="#7F98B5"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

            </LinearLayout>

            <TextView
                android:id="@+id/ChangeDeviceButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="?attr/selectableItemBackground"
                android:text="CHANGE"
                android:textColor="#72B7F5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:contentDescription="Change War Thunder device" />

            <View
                android:layout_width="1dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="#29394C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="LIVE"
                android:textColor="#72D69B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="7dp"
                android:background="#72D69B" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:background="#151F2D">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#E5A84B" />

            <TextView
                android:id="@+id/ConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Searching for War Thunder..."
                android:textColor="#C3D0DF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/SessionCode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="#202F42"
                android:text="CODE: ------"
                android:textColor="#72B7F5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:visibility="gone"
                android:contentDescription="Multiplayer session code" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/MapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="#080D14"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/Map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="War Thunder map"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/SearchMapHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#CC080D14"
                android:padding="24dp"
                android:text="WAITING FOR WAR THUNDER"
                android:textColor="#8FA5BD"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="#CC111A27"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="TACTICAL VIEW"
                android:textColor="#9FB5CE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="#CC111A27"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="WAR THUNDER API"
                android:textColor="#7189A5"
                android:textSize="9sp"
                android:textStyle="bold" />

        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/DrawingLegendScroll"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="#111A27"
            android:scrollbars="none"
            android:fillViewport="false"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/DrawingLegend"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/MapLegendScroll"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="#111A27"
            android:scrollbars="none"
            android:fillViewport="false"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/MapLegend"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </HorizontalScrollView>

    </LinearLayout>

    <View
        android:id="@+id/MenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/SideMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111A27"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:background="#172435">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAR THUNDER"
                android:textColor="#EAF2FC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MAP DRAW"
                android:textColor="#7F98B5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#29394C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="8dp"
            android:text="TOOLS"
            android:textColor="#657E99"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/DrawMapOption"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:text="Draw Map"
            android:textColor="#DCE8F5"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#29394C" />

    </LinearLayout>

</FrameLayout>