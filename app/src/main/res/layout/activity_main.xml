<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1018"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B1018">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:background="#111A27"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/TacticalMap"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="Open menu"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="#DCE8F5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WTDrawMap"
                    android:textColor="#EAF2FC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="TACTICAL MAP"
                    android:textColor="#7F98B5"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

            </LinearLayout>

            <TextView
                android:id="@+id/ChangeDeviceButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="?attr/selectableItemBackground"
                android:text="CHANGE"
                android:textColor="#72B7F5"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:contentDescription="Change War Thunder device" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="7dp"
            android:background="#151F2D">

            <TextView
                android:id="@+id/ConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Searching for War Thunder..."
                android:textColor="#C3D0DF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/SessionCode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:background="#202F42"
                android:text="CODE: ------"
                android:textColor="#72B7F5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:visibility="gone"
                android:contentDescription="Multiplayer session code" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/MapContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:background="#080D14"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/Map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="War Thunder map"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/SearchMapHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="#CC080D14"
                android:padding="20dp"
                android:text="WAITING FOR WAR THUNDER"
                android:textColor="#8FA5BD"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="#CC111A27"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="TACTICAL VIEW"
                android:textColor="#9FB5CE"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="#CC111A27"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="WAR THUNDER API"
                android:textColor="#7189A5"
                android:textSize="8sp"
                android:textStyle="bold" />

        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/DrawingLegendScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:background="#111A27"
            android:scrollbars="none"
            android:fillViewport="false"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/DrawingLegend"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/MapLegendScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="7dp"
            android:background="#111A27"
            android:scrollbars="none"
            android:fillViewport="false"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/MapLegend"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </HorizontalScrollView>

    </LinearLayout>

    <View
        android:id="@+id/MenuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/SideMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111A27"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:background="#172435">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WTDrawMap"
                android:textColor="#EAF2FC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="TACTICAL MAP"
                android:textColor="#7F98B5"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#29394C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:text="TOOLS"
            android:textColor="#657E99"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:id="@+id/DrawMapOption"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:text="Draw Map"
            android:textColor="#DCE8F5"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="#29394C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="9dp"
            android:text="MULTIPLAYER"
            android:textColor="#657E99"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:text="PARTICIPANTS"
            android:textColor="#9FB5CE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="true">

            <LinearLayout
                android:id="@+id/ParticipantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="#29394C" />

        <TextView
            android:id="@+id/LeaveSessionButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="#38212A"
            android:gravity="center"
            android:text="NO ACTIVE SESSION"
            android:textColor="#FF8290"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:enabled="false" />

    </LinearLayout>

</FrameLayout>